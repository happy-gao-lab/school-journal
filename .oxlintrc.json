{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["eslint", "typescript", "unicorn", "oxc", "import"],
    "jsPlugins": ["./lint/oxlint-plugin.mjs"],
    "categories": {
        "correctness": "warn"
    },
    "rules": {
        "no-unused-vars": [
            "warn",
            {
                "vars": "all",
                "args": "after-used",
                "ignoreRestSiblings": true,
                "argsIgnorePattern": "^_",
                "varsIgnorePattern": "^_",
                "caughtErrors": "none"
            }
        ],
        "id-length": [
            "warn",
            {
                "min": 2,
                "exceptions": ["_"],
                "properties": "never"
            }
        ],
        "func-style": ["warn", "expression"],
        "import/no-anonymous-default-export": "warn",
        "no-console": "warn",
        "eqeqeq": "warn",
        "prefer-const": "warn",
        "no-var": "warn",
        "typescript/no-explicit-any": "warn",
        "school-journal/no-block-arrow-argument": "warn"
    },
    "overrides": [
        {
            "files": ["apps/backend/**"],
            "env": {
                "node": true
            },
            "rules": {
                "typescript/no-floating-promises": "warn"
            }
        },
        {
            "files": ["**/*.spec.*", "**/*.test.*", "**/test/**", "**/tests/**"],
            "rules": {
                "school-journal/no-block-arrow-argument": "off"
            }
        },
        {
            "files": ["apps/frontend/**"],
            "plugins": ["react", "nextjs", "jsx-a11y"],
            "env": {
                "browser": true
            },
            "rules": {
                "react/function-component-definition": [
                    "warn",
                    {
                        "namedComponents": "arrow-function",
                        "unnamedComponents": "arrow-function"
                    }
                ],
                "react/exhaustive-deps": "warn",
                "react/rules-of-hooks": "warn",
                "react/jsx-key": "warn",
                "school-journal/no-inline-jsx-function": "warn"
            }
        }
    ]
}
