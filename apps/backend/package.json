{
    "name": "backend",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "nest build",
        "dev": "nest start --watch --preserveWatchOutput",
        "start": "NODE_ENV=production node dist/main.js",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint --deny-warnings --type-aware .",
        "test": "vitest run",
        "test:e2e": "vitest run -c vitest.config.e2e.ts",
        "db:generate": "pnpm --filter @school-journal/shared build && drizzle-kit generate",
        "db:migrate": "pnpm --filter @school-journal/shared build && drizzle-kit migrate",
        "db:seed": "pnpm --filter @school-journal/shared build && tsx src/db/seed.ts"
    },
    "dependencies": {
        "@neondatabase/serverless": "^1.2.0",
        "@nestjs/common": "^12.2.0",
        "@nestjs/core": "^12.2.0",
        "@nestjs/jwt": "^12.0.3",
        "@nestjs/platform-express": "^12.2.0",
        "@nestjs/schedule": "^12.0.2",
        "@nestjs/swagger": "^12.0.3",
        "@nestjs/throttler": "^6.7.1",
        "@school-journal/shared": "workspace:*",
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "dotenv": "~18.0.8",
        "drizzle-orm": "1.0.0-rc.5",
        "helmet": "^8.3.0",
        "nestjs-pino": "^5.3.1",
        "pino-http": "^11.0.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "tsx": "^4.23.15",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@electric-sql/pglite": "^0.5.12",
        "@nestjs/cli": "^12.0.10",
        "@nestjs/testing": "^12.2.0",
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.6",
        "@types/node": "^24.19.2",
        "@types/supertest": "^7.2.1",
        "drizzle-kit": "1.0.0-rc.5",
        "pino-pretty": "^13.2.0",
        "supertest": "^7.3.1",
        "typescript": "^6.0.2"
    }
}
