# development | production | test
NODE_ENV=development
PORT=4000
# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:3000
# Optional: fatal | error | warn | info | debug | trace | silent
# Defaults by NODE_ENV: production → info, test → silent, development → debug
# LOG_LEVEL=debug
# Direct (non-pooler) Neon connection string, also used by db:migrate
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# JWT signing secrets, at least 32 characters each and different from each other,
# e.g. generated with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
